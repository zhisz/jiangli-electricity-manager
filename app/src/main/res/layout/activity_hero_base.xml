<?xml version="1.0" encoding="utf-8"?>
<!--
  基地主体可同时作为独立页面和首页抽屉使用。内容区可滚动，但底部操作栏固定，不会随
  “关于电小侠”一起滚走；颜色全部来自当前应用主题的深浅色资源。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroBasePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:id="@+id/heroBaseRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/baseBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="返回"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/base_text"
                android:textSize="34sp" />

            <!-- 气泡与角色属于同一舞台，尾巴紧贴角色头部，形成真正“角色在说话”的关系。 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="236dp">

                <ImageView
                    android:id="@+id/baseMascotImage"
                    android:layout_width="178dp"
                    android:layout_height="178dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:clickable="true"
                    android:contentDescription="会动的电小侠，点击和它互动"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_base_character" />

                <com.shangzhili.electricityreminder.CloudSpeechTextView
                    android:id="@+id/baseGreetingText"
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:minHeight="76dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="电小侠基地"
                android:textColor="@color/base_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/baseMascotStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textColor="@color/base_lightning"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="今日状态"
                android:textColor="@color/base_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <TextView android:id="@+id/baseMonitoringText" style="@style/BaseStatusCell" android:text="监测房间\n0" />
                <TextView android:id="@+id/baseLowText" style="@style/BaseStatusCell" android:text="余额不足\n0" />
                <TextView android:id="@+id/baseSystemText" style="@style/BaseStatusCell" android:text="系统设置\n检查中" />
                <TextView android:id="@+id/baseVersionText" style="@style/BaseStatusCell" android:text="应用版本\n检查中" />
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="关于电小侠"
                android:textColor="@color/base_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/base_card_background"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/baseAboutVersionText" style="@style/BaseAboutText" />
                <TextView style="@style/BaseAboutText" android:text="开发者　zhiSZ" />
                <TextView style="@style/BaseAboutText" android:text="联系我　3357627169@qq.com" />
            </LinearLayout>

            <Button android:id="@+id/baseFeedbackButton" style="@style/BaseToolButton" android:text="意见反馈（需署名）　›" />
            <Button android:id="@+id/baseGithubButton" style="@style/BaseToolButton" android:text="GitHub 开源地址　›" />
            <Button android:id="@+id/basePrivacyButton" style="@style/BaseToolButton" android:text="隐私与数据说明　›" />
        </LinearLayout>
    </ScrollView>

    <!-- 底栏固定并整体靠左；两个按钮保持紧凑，不再机械平分整行。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/base_background"
        android:elevation="10dp"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/baseSettingsButton"
            style="@style/BaseBottomButton"
            android:layout_width="108dp"
            android:text="⚙　设置" />

        <Button
            android:id="@+id/baseAppearanceButton"
            style="@style/BaseBottomButton"
            android:layout_width="108dp"
            android:layout_marginStart="8dp"
            android:text="☀　浅色" />
    </LinearLayout>
</FrameLayout>
