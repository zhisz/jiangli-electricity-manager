<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="32dp">

        <!-- 顶部只保留返回与页面名称，避免旧页面的“设置与检查”产生双重任务感。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsBackButton"
                style="@style/Ui.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="‹ 返回" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第一张卡只回答“后台提醒能否正常工作”；复杂权限项默认不占首屏。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Ui.Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提醒环境" />

                <TextView
                    android:id="@+id/overallStatusText"
                    style="@style/Ui.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="正在检查系统设置……" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/systemDetailsToggle"
                    style="@style/Ui.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="查看系统设置" />

                <!-- 展开时仍保留全部旧功能和状态，收起不会改变任何设置。 -->
                <LinearLayout
                    android:id="@+id/advancedSystemContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/notificationStatusText"
                        style="@style/Ui.Text.Body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:text="通知权限与通知渠道" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openNotificationSettingsButton" style="@style/Ui.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="设置通知权限" />

                    <TextView android:id="@+id/exactAlarmStatusText"
                        style="@style/Ui.Text.Body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="精确闹钟权限" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openExactAlarmSettingsButton" style="@style/Ui.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="设置精确闹钟" />

                    <TextView android:id="@+id/batteryStatusText"
                        style="@style/Ui.Text.Body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="忽略系统电池优化" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openBatterySettingsButton" style="@style/Ui.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="设置电池策略" />

                    <TextView android:id="@+id/autoStartStatusText"
                        style="@style/Ui.Text.Body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="厂商自启动" android:textStyle="bold" />
                    <TextView style="@style/Ui.Text.Body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="部分手机无法自动检测自启动状态，需要在系统中开启后手动确认。" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openAutoStartSettingsButton" style="@style/Ui.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="打开本 App 系统设置" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/autoStartConfirmButton" style="@style/Ui.Button.Text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="我已开启自启动" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 外观优先给出最常用的深浅模式；品牌色属于低频个性化，默认收起。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/card_padding">
                <TextView style="@style/Ui.Text.SectionTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="外观" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/appearanceModeGroup"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appearanceSystemRadio" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:checkable="true"
                        android:text="跟随系统" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appearanceLightRadio" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:checkable="true"
                        android:text="浅色" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appearanceDarkRadio" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:checkable="true"
                        android:text="深色" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDetailsToggle" style="@style/Ui.Button.Text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="更改主题颜色" />
                <LinearLayout android:id="@+id/themeDetailsContent"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/themeModeGroup" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        app:selectionRequired="true" app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/themeBlueRadio"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                            android:layout_height="48dp" android:layout_weight="1" android:checkable="true"
                            android:text="学院蓝" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/themeJadeRadio"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                            android:layout_height="48dp" android:layout_weight="1" android:checkable="true"
                            android:text="清新绿" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/themePurpleRadio"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
                            android:layout_height="48dp" android:layout_weight="1" android:checkable="true"
                            android:text="静雅紫" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeColor="@color/border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/card_padding">
                <TextView style="@style/Ui.Text.SectionTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="常用工具" />
                <com.google.android.material.button.MaterialButton android:id="@+id/manualUpdateButton"
                    style="@style/Ui.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="检查应用更新" />
                <com.google.android.material.button.MaterialButton android:id="@+id/dataStorageButton"
                    style="@style/Ui.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="数据与存储" />
                <com.google.android.material.button.MaterialButton android:id="@+id/usageHelpButton"
                    style="@style/Ui.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="使用说明" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:text="@string/developer_signature"
            android:textColor="@color/text_tertiary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/feedbackEmailButton"
            style="@style/Ui.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/feedback_email"
            android:textColor="@color/text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/filingNumberButton"
            style="@style/Ui.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_filing_number"
            android:contentDescription="打开工信部备案系统查询 APP 备案信息"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
