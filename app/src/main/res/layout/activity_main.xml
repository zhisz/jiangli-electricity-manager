<?xml version="1.0" encoding="utf-8"?>
<!--
  详情页按“余额 → 图表 → 快捷功能 → 监测状态 → 设置”组织。
  普通查看场景不会先遇到长表单；设置内容折叠时仍保留 Activity 中的输入状态。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="32dp">

        <!-- 顶部导航保持克制：返回是文字操作，房间名允许两行以适配长别名和大字体。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                style="@style/Ui.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回" />

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="房间详情"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 余额总览是第一视觉焦点；刷新缩成卡片内次操作，不再占据整行。 -->
        <LinearLayout
            android:id="@+id/balanceOverviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="当前余额"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/queryButton"
                    style="@style/Ui.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="↻ 刷新" />
            </LinearLayout>

            <TextView
                android:id="@+id/balanceSurplusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="--.-- 度"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/balanceAmountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="折算金额 --.-- 元"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/balanceUpdatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="尚未查询"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/balanceStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/status_pill_neutral"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="等待首次查询"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 电费充值仍由微信完成付款；这里保持次级按钮权重，不抢过余额主数据。 -->
            <Button
                android:id="@+id/openOnlineRechargeButton"
                style="@style/Ui.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/online_recharge_button" />
        </LinearLayout>

        <!-- 图表相关开关统一使用分段控件，弱化原 RadioButton 的表单感。 -->
        <LinearLayout
            android:id="@+id/chartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/trendTitleText"
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每日消耗 · 30 天" />

            <RadioGroup
                android:id="@+id/chartModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/segment_container_background"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/dailyUsageRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="每日消耗" />

                <RadioButton
                    android:id="@+id/balanceTrendRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="余额趋势" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/balanceTrendContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/trendMetricGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/segment_container_background"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/electricityTrendRadio"
                        style="@style/Ui.SegmentButton"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="电量" />

                    <RadioButton
                        android:id="@+id/amountTrendRadio"
                        style="@style/Ui.SegmentButton"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:text="电费" />
                </RadioGroup>

                <!--
                  纵轴固定在屏幕左侧，时间内容独立横向滚动。最近 30 天最多约 720 个
                  小时点，不会被压缩到一屏；初次展示由 Activity 自动定位到最右侧最新值。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.shangzhili.electricityreminder.BalanceTrendAxisView
                        android:id="@+id/balanceTrendAxisView"
                        android:layout_width="48dp"
                        android:layout_height="260dp" />

                    <HorizontalScrollView
                        android:id="@+id/balanceTrendScrollView"
                        android:layout_width="0dp"
                        android:layout_height="270dp"
                        android:layout_weight="1"
                        android:fillViewport="false"
                        android:scrollbars="horizontal">

                        <com.shangzhili.electricityreminder.ElectricityTrendView
                            android:id="@+id/trendView"
                            android:layout_width="wrap_content"
                            android:layout_height="260dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:id="@+id/trendDetailText"
                    style="@style/Ui.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/status_background"
                    android:padding="@dimen/space_3"
                    android:text="余额延迟刷新时会用虚线均摊已确认的累计消耗；细点线表示仍待数据源结算。点击时段可查看估算窗口，橙色竖线表示充值。"
                    android:textColor="?attr/uiPrimaryDark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dailyUsageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/dailyUsageRangeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/segment_container_background"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/dailyUsage30Radio"
                        style="@style/Ui.SegmentButton"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="30 天" />

                    <RadioButton
                        android:id="@+id/dailyUsage60Radio"
                        style="@style/Ui.SegmentButton"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:text="60 天" />
                </RadioGroup>

                <TextView
                    android:id="@+id/dailyUsageDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/status_background"
                    android:padding="@dimen/space_3"
                    android:text="点击柱子查看日期、当天用量和金额"
                    android:textColor="?attr/uiPrimaryDark"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.shangzhili.electricityreminder.DailyUsageAxisView
                        android:id="@+id/dailyUsageAxisView"
                        android:layout_width="48dp"
                        android:layout_height="220dp" />

                    <HorizontalScrollView
                        android:id="@+id/dailyUsageScrollView"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_weight="1"
                        android:fillViewport="false"
                        android:scrollbars="horizontal">

                        <com.shangzhili.electricityreminder.DailyUsageBarView
                            android:id="@+id/dailyUsageBarView"
                            android:layout_width="wrap_content"
                            android:layout_height="220dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    style="@style/Ui.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="左右滑动查看更多日期；灰色短线表示仍待余额源结算或缺少有效采样。"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/historySummaryText"
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="暂无历史数据"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 两项历史相关功能并排，权重相同且不与保存主操作竞争。 -->
        <LinearLayout
            android:id="@+id/quickActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openUsageStatisticsButton"
                style="@style/Ui.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="月度用电统计" />

            <Button
                android:id="@+id/openRechargeRecordsButton"
                style="@style/Ui.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="记录充值" />
        </LinearLayout>

        <!-- 独立状态卡同时展示文字状态、全部时间和低余额复查间隔。 -->
        <LinearLayout
            android:id="@+id/monitorStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="监测状态" />

            <TextView
                android:id="@+id/monitorStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="等待首次查询"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scheduleText"
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="保存设置后显示监测计划" />
        </LinearLayout>

        <!-- 房间码已在首页添加窗口确定，详情页只保留用户真正需要修改的备注。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/aliasInput"
                android:text="房间备注"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/aliasInput"
                    style="@style/Ui.EditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="例如：我的宿舍"
                    android:inputType="text"
                    android:maxLength="40"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/saveAliasButton"
                    style="@style/Ui.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="保存" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/reminderSettingsHeaderButton"
            style="@style/Ui.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="start|center_vertical"
            android:text="提醒设置  ▾" />

        <LinearLayout
            android:id="@+id/reminderSettingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="判断指标"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/metricGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/segment_container_background"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/amountRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="按金额（元）" />

                <RadioButton
                    android:id="@+id/surplusRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按电量（度）" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:labelFor="@id/thresholdInput"
                android:text="提醒阈值"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/thresholdInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="例如 20"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:labelFor="@id/recoveryInput"
                android:text="恢复阈值"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/recoveryInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="必须大于提醒阈值"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:labelFor="@id/repeatMinutesInput"
                android:text="余额不足后的复查间隔（分钟）"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/repeatMinutesInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="例如 60"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/status_background"
                android:padding="@dimen/space_3"
                android:text="启用后默认在每天 00:00–23:00 的每个整点自动查询并记录，无需逐项设置时间。"
                android:textColor="?attr/uiPrimaryDark"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="保存并启用监测" />

        <Button
            android:id="@+id/cancelMonitoringButton"
            style="@style/Ui.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="取消整点监测" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Ui.Button.DangerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="删除此房间" />
    </LinearLayout>
</ScrollView>
