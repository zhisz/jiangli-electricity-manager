<?xml version="1.0" encoding="utf-8"?>
<!--
  房间详情采用固定一屏结构，只保留用户最高频的“当前余额”和“余额趋势”。
  图表卡片使用剩余高度自适应，小屏上不会因为固定图高把页面撑成纵向滚动页。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/page_horizontal"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/backButton"
            style="@style/Ui.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="房间详情"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/roomSettingsButton"
            style="@style/Ui.Button.Text"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="房间设置"
            android:text="⚙" />
    </LinearLayout>

    <!-- 当前余额保留刷新、双状态和充值，其他低频信息全部移出首屏。 -->
    <LinearLayout
        android:id="@+id/balanceOverviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/room_card_background"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="当前余额"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/queryButton"
                style="@style/Ui.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="↻ 刷新" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/balanceSurplusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--.-- 度"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/balanceAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="约 --.-- 元"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/balanceUpdatedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="尚未查询"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/balanceStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill_neutral"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="等待查询"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/monitorStatePillText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/status_pill_neutral"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="32dp"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="未开启"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/openOnlineRechargeButton"
            style="@style/Ui.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/online_recharge_button" />
    </LinearLayout>

    <!--
      趋势图占满余额卡片之后的剩余空间。标题区仅保留名称和“度/元”切换；
      采样详情由图内点选反馈表达，不再长期摆放说明段落。
    -->
    <LinearLayout
        android:id="@+id/chartCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1"
        android:background="@drawable/room_card_background"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trendTitleText"
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="余额趋势" />

            <RadioGroup
                android:id="@+id/trendMetricGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/segment_container_background"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/electricityTrendRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="58dp"
                    android:layout_height="40dp"
                    android:checked="true"
                    android:text="度" />

                <RadioButton
                    android:id="@+id/amountTrendRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="58dp"
                    android:layout_height="40dp"
                    android:text="元" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/balanceTrendContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_2"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="horizontal">

            <com.shangzhili.electricityreminder.BalanceTrendAxisView
                android:id="@+id/balanceTrendAxisView"
                android:layout_width="48dp"
                android:layout_height="match_parent" />

            <HorizontalScrollView
                android:id="@+id/balanceTrendScrollView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.shangzhili.electricityreminder.ElectricityTrendView
                    android:id="@+id/trendView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
