<?xml version="1.0" encoding="utf-8"?>
<!--
  房间级配置集中在独立页面。备注和提醒规则使用不同保存按钮，避免一个轻量修改
  意外改变后台监测状态；危险操作固定在页面末端。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/page_horizontal"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsBackButton"
                style="@style/Ui.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回" />

            <TextView
                style="@style/Ui.Text.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="房间设置"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="房间备注" />

            <EditText
                android:id="@+id/settingsAliasInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="例如：我的宿舍"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1" />

            <Button
                android:id="@+id/settingsSaveAliasButton"
                style="@style/Ui.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="单独保存备注" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/room_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Ui.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="余额监测与提醒" />

            <TextView
                android:id="@+id/settingsMonitoringSummaryText"
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/status_background"
                android:padding="@dimen/space_3"
                android:text="读取监测状态中" />

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="判断指标"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/segment_container_background"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/settingsAmountRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按金额（元）" />

                <RadioButton
                    android:id="@+id/settingsSurplusRadio"
                    style="@style/Ui.SegmentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按电量（度）" />
            </RadioGroup>

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="余额不足阈值"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsThresholdInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="例如 20"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="恢复阈值"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsRecoveryInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="必须大于余额不足阈值"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="余额不足后的复查间隔（分钟）"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsRepeatMinutesInput"
                style="@style/Ui.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="例如 60"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Ui.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="启用后每天 00:00–23:00 每个整点查询；余额不足时按上方间隔复查。" />

            <Button
                android:id="@+id/settingsEnableButton"
                style="@style/Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="保存提醒设置并启用监测" />

            <Button
                android:id="@+id/settingsDisableButton"
                style="@style/Ui.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="关闭余额监测" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsDeleteButton"
            style="@style/Ui.Button.DangerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="删除此房间" />
    </LinearLayout>
</ScrollView>
