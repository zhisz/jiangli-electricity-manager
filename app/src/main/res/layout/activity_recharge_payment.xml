<?xml version="1.0" encoding="utf-8"?>
<!--
    该页面只承载校付宝与微信支付白名单页面，并不是通用浏览器。
    WebView 占据剩余空间，避免支付页在小屏幕或大字体下被固定高度裁切。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/page_horizontal"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rechargePaymentCloseButton"
            style="@style/Ui.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/recharge_payment_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:text="@string/recharge_payment_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/rechargePaymentProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/rechargePaymentStatusText"
            style="@style/Ui.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/recharge_payment_connecting" />
    </LinearLayout>

    <!--
        外层卡片只负责统一圆角和边界；WebView 本身不保存任何订单 URL 到应用配置。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1"
        android:background="@drawable/room_card_background"
        android:padding="1dp">

        <WebView
            android:id="@+id/rechargePaymentWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:contentDescription="@string/recharge_payment_web_content" />
    </FrameLayout>

</LinearLayout>
