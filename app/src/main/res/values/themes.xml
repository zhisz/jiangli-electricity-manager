<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/status_danger</item>
        <item name="materialAlertDialogTheme">@style/BaseDialogTheme</item>
    </style>

    <!-- 默认学院蓝继续使用原品牌色，老用户升级后视觉不会突然变化。 -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:colorAccent">@color/primary</item>
        <item name="uiPrimary">@color/primary</item>
        <item name="uiPrimaryDark">@color/primary_dark</item>
        <item name="uiPrimarySoft">@color/primary_soft</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
    </style>

    <style name="AppTheme.Jade" parent="AppThemeBase">
        <item name="android:colorAccent">@color/jade_primary</item>
        <item name="uiPrimary">@color/jade_primary</item>
        <item name="uiPrimaryDark">@color/jade_primary_dark</item>
        <item name="uiPrimarySoft">@color/jade_primary_soft</item>
        <item name="colorPrimary">@color/jade_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/jade_primary</item>
    </style>

    <style name="AppTheme.Purple" parent="AppThemeBase">
        <item name="android:colorAccent">@color/purple_primary</item>
        <item name="uiPrimary">@color/purple_primary</item>
        <item name="uiPrimaryDark">@color/purple_primary_dark</item>
        <item name="uiPrimarySoft">@color/purple_primary_soft</item>
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/purple_primary</item>
    </style>

    <style name="Ui.Text.PageTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ui.Text.SectionTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Ui.Text.Body" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Ui.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Ui.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:textColor">?attr/uiPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Ui.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:background">@drawable/button_text_background</item>
        <item name="android:textColor">?attr/uiPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Ui.Button.DangerText" parent="Ui.Button.Text">
        <item name="android:textColor">@color/status_danger</item>
    </style>

    <style name="Ui.EditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/edit_text_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Ui.SegmentButton" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/segment_item_background</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="BaseStatusCell" parent="android:style/Widget.TextView">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">84dp</item>
        <item name="android:layout_columnWeight">1</item><item name="android:gravity">center</item>
        <item name="android:background">@drawable/base_card_background</item>
        <item name="android:textColor">@color/base_text</item><item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
    <style name="BaseToolButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item><item name="android:background">@drawable/base_tool_background</item>
        <item name="android:textColor">@color/base_text</item><item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item><item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item>
        <item name="android:elevation">0dp</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BaseAboutText" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/base_muted</item><item name="android:textSize">14sp</item>
        <item name="android:paddingTop">6dp</item><item name="android:paddingBottom">6dp</item>
    </style>
    <style name="BaseBottomButton" parent="BaseToolButton">
        <item name="android:layout_height">48dp</item><item name="android:layout_marginTop">0dp</item>
        <item name="android:gravity">center</item><item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="BaseDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/uiPrimary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Elec.Dialog</item>
    </style>

    <style name="ShapeAppearance.Elec.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
</resources>
