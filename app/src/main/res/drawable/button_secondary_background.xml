<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="?attr/uiPrimarySoft"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="?attr/uiPrimary"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="@color/border"/></shape>
    </item>
</selector>
