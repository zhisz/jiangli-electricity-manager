<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        夜间限定资源只替换公共基础主题；三套品牌色继续继承此主题，
        从而避免维护三份重复的深色控件规范。
    -->
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 夜间弹窗必须使用深色 Material 父主题，否则只有背景变暗而按钮和文字仍按浅色计算。 -->
    <style name="BaseDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/base_dialog_background</item>
        <item name="android:colorAccent">@color/purple_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
