<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        夜间限定资源只替换公共基础主题；三套品牌色继续继承此主题，
        从而避免维护三份重复的深色控件规范。
    -->
    <style name="AppThemeBase" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/status_danger</item>
        <item name="materialAlertDialogTheme">@style/BaseDialogTheme</item>
    </style>

    <!-- 夜间弹窗必须使用深色 Material 父主题，否则只有背景变暗而按钮和文字仍按浅色计算。 -->
    <style name="BaseDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/uiPrimary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Elec.Dialog</item>
    </style>
</resources>
